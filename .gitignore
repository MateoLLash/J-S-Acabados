metadata.json

# Entornos virtuales de Python (si usas venv)
venv/
.venv/
env/

# Archivos de entorno y variables secretas
.env
.env.local
.env.*.local

# Archivos del editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db

# Logs generales (scraper.log no lo cubre npm-debug.log*)
*.log

